{
    "project": "wmr",
    "plan_root": "plans/wmr",
    "entrypoint": "plans/wmr/master_plan.md",
    "outputs": {
      "bundle_dir": "build/wmr/bundle",
      "reports_dir": "build/wmr/reports"
    },
    "safety": {
      "allowed_read_roots": [
        "plans/wmr",
        "docs",
        "pages",
        "data",
        "guard_plan_assembler"
      ],
      "allowed_write_roots": [
        "build/wmr"
      ],
      "deny_write_roots": [
        "plans",
        "docs",
        "pages",
        "data",
        "guard_plan_assembler",
        ".github"
      ]
    },
    "guards": {
      "fail_on_missing_files": true,
      "fail_on_broken_internal_links": true,
      "fail_on_todo_markers": false,
      "todo_markers": [
        "TODO:",
        "TBD:",
        "<<<"
      ],
      "required_sections": [
        "Vision",
        "Core Values",
        "System Architecture",
        "Pillars",
        "Implementation Roadmap",
        "Governance Mechanics",
        "Fiscal/Economic Model",
        "Institutions & Checks",
        "Citizen Participation",
        "Transition Plan",
        "Risk & Attack Surface",
        "Sources & Evidence"
      ]
    }
  }
  